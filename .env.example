# Copy to .env only when you operate the service. Never commit a real key or token.
# Development (the default): everything is optional; with no values the app runs in demo mode with
# deterministic English/Hindi/Bhojpuri counselling, no AI calls, and research routes closed.
# Production (ABHAYNAYAN_ENV=production): the variables marked REQUIRED IN PRODUCTION must hold real values,
# otherwise the app refuses to start. Every placeholder below is deliberately rejected by the validator.
# Full reference: docs/configuration.md

# --- Environment and authentication ---
# development | test | production. Any other value refuses to start.
ABHAYNAYAN_ENV=development
# REQUIRED IN PRODUCTION. 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# A missing, short or placeholder key disables the research routes (503 AUTH_NOT_CONFIGURED) in any environment.
ABHAYNAYAN_SESSION_SIGNING_KEY=replace-with-output-of-secrets-token_urlsafe-48
# Optional. Maximum access-token lifetime in seconds (60-43200).
ABHAYNAYAN_TOKEN_MAX_TTL_SECONDS=3600
# Optional. Research-route limits per research operator (engineering defaults, not validated values).
ABHAYNAYAN_IMAGE_RATE_PER_MINUTE=10
ABHAYNAYAN_IMAGE_RATE_PER_DAY=100
ABHAYNAYAN_IMAGE_MAX_CONCURRENT=2
ABHAYNAYAN_AUTH_FAILURES_PER_MINUTE_PER_IP=20
# Optional. Upload limit in bytes; can be lowered but not raised above 8 MB.
ABHAYNAYAN_MAX_IMAGE_BYTES=8388608

# --- Gemini (server-side only; never place these in frontend or Android code) ---
GEMINI_API_KEY=
# No default. Pick a current model ID from https://ai.google.dev/gemini-api/docs/models
# (e.g. gemini-3.8-flash was listed as stable on 2026-10-10). The server verifies it via models.get.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- Admin usage report (/api/admin/usage). Optional; empty disables it. 16+ characters in development;
# in production 32+ random characters and no placeholder words, otherwise startup fails. ---
ABHAYNAYAN_ADMIN_TOKEN=

# --- Research only. Keep 0. Not allowed in production (startup fails). Even when 1, research routes also
# need a research_operator access token (scripts/issue_access_token.py). ---
ABHAYNAYAN_ENABLE_EXPERIMENTAL_ANEMIA=0
ABHAYNAYAN_ENABLE_EXPERIMENTAL_IMAGE_MODELS=0

ABHAYNAYAN_PORT=8000
# REQUIRED IN PRODUCTION as explicit https:// origins (no *). The domain is not decided yet.
ABHAYNAYAN_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Production runs a single worker: the rate limiter keeps its counters in process memory.
# WEB_CONCURRENCY=1
# ABHAYNAYAN_DB_PATH=backend/data/abhaynayan.sqlite3
# ABHAYNAYAN_PDF_FONT=/path/to/NotoSansDevanagari-Regular.ttf
# ABHAYNAYAN_PDF_FONT_BOLD=/path/to/NotoSansDevanagari-Bold.ttf
