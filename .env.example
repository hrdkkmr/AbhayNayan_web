# Copy to .env only when you operate the service. Never commit a real key or token.
# Everything is optional: with no values the app runs in demo mode with deterministic
# English/Hindi/Bhojpuri counselling and no AI calls.

# --- Gemini (server-side only; never place these in frontend or Android code) ---
GEMINI_API_KEY=
# No default. Pick a current model ID from https://ai.google.dev/gemini-api/docs/models
# (e.g. gemini-3.8-flash was listed as stable on 2026-10-10). The server verifies it via models.get.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_OUTPUT_TOKENS=512

# --- Admin usage report (/api/admin/usage). Empty disables it. Use 16+ random characters. ---
ABHAYNAYAN_ADMIN_TOKEN=

# --- Research only. 1 enables the non-validated anemia colour baseline for research-dataset features. ---
ABHAYNAYAN_ENABLE_EXPERIMENTAL_ANEMIA=0

ABHAYNAYAN_PORT=8000
ABHAYNAYAN_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# ABHAYNAYAN_DB_PATH=backend/data/abhaynayan.sqlite3
# ABHAYNAYAN_PDF_FONT=/path/to/NotoSansDevanagari-Regular.ttf
# ABHAYNAYAN_PDF_FONT_BOLD=/path/to/NotoSansDevanagari-Bold.ttf
